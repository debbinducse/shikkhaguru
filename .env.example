# সাইটের সম্পূর্ণ URL (শেষে slash ছাড়া)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# যোগাযোগের ইমেইল (প্রোডাকশনে অবশ্যই বদলান)
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Google Search Console যাচাইকরণ (ঐচ্ছিক)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx

# Google AdSense (ঐচ্ছিক) — অনুমোদনের পর পাবলিশার আইডি বসান
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_CHAPTER_SLOT=1234567890
